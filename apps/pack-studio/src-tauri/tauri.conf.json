{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PackStudio",
  "version": "0.3.0-beta.1",
  "identifier": "com.packstudio.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PackStudio — Resource Pack Artist Workbench (Java + Bedrock)",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#1E1E1E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
