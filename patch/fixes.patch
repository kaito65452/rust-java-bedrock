+/// Independent numeric check of the composition/fixed-point formula: rotate a corner through
+/// the bone chain point-by-point and compare with the single rotation the converter emits.
+#[test]
+fn chain_with_different_pivots_matches_pointwise_rotation() {
+    use rp_transforms::model::{java_to_bedrock_pivot, java_to_bedrock_rotation};
+    fn rot_z(p: [f32; 2], c: [f32; 2], deg: f32) -> [f32; 2] {
+        let (s, k) = deg.to_radians().sin_cos();
+        let (dx, dy) = (p[0] - c[0], p[1] - c[1]);
+        [c[0] + k * dx - s * dy, c[1] + s * dx + k * dy]
+    }
+    let (els, report) = to_java(&format!(
+        r#"{{
+      "format_version":"1.12.0","minecraft:geometry":[{{
+        "description":{{"identifier":"geometry.t","texture_width":16,"texture_height":16}},
+        "bones":[
+          {{"name":"a","pivot":[0,12,0],"rotation":[0,0,30]}},
+          {{"name":"b","parent":"a","pivot":[4,6,0],"rotation":[0,0,-10],
+            "cubes":[{{"origin":[1,2,-2],"size":[4,4,4],{FACE}}}]}}
+        ]}}]}}"#
+    ));
+    assert_eq!(report.lossy_count, 0);
+    let r = els[0].rotation.as_ref().expect("net 20° rotation");
+    assert_eq!(r.axis, RotationAxis::Z);
+    assert!((r.angle - 20.0).abs() < 1e-3, "angle {}", r.angle);
+
+    // Ground truth: bone b rotation first (-10° about (4,6)), then bone a (30° about (0,12)).
+    let corner = [1.0f32, 2.0];
+    let truth = rot_z(rot_z(corner, [4.0, 6.0], -10.0), [0.0, 12.0], 30.0);
+    // Converter result: undo the Java mapping of the *unrotated* cube, apply the emitted rotation.
+    let bp = java_to_bedrock_pivot(r.origin);
+    let b_rot = java_to_bedrock_rotation(r.axis, r.angle);
+    let got = rot_z(corner, [bp[0], bp[1]], b_rot[2]);
+    assert!(
+        (truth[0] - got[0]).abs() < 1e-3 && (truth[1] - got[1]).abs() < 1e-3,
+        "truth {truth:?} vs converter {got:?}"
+    );
+}
